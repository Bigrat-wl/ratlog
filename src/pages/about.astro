---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { AUTHOR, EMAIL, SITE_DESCRIPTION, SOCIALS } from '../consts';
---

<BaseLayout title="About" description={SITE_DESCRIPTION}>
	<div class="prose slide-enter-content">
		<h1>About</h1>

		<p>
			嗨，我是 {AUTHOR}。
		</p>

		<h2>关于这个站点</h2>

		<p>
			这里是我的数字花园，用来记录技术笔记、项目复盘和一些不那么技术的内容。文章会慢慢变多，也可能会有删改，随缘更新。
		</p>

		<p>
			站点使用 <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
			构建，视觉风格参考了
			<a href="https://antfu.me" target="_blank" rel="noopener noreferrer">antfu.me</a>。没有评论系统，也没有广告，只有文字。
		</p>

		<hr />

		<p>Find me on</p>
		<p class="socials">
			{SOCIALS.map((social) => (
				<a
					href={social.url}
					target={social.url.startsWith('http') ? '_blank' : undefined}
					rel={social.url.startsWith('http') ? 'noopener noreferrer' : undefined}
				>
					<Icon name={social.icon} size={18} />
					{social.name}
				</a>
			))}
		</p>

		<p>
			Or mail me at <a href={`mailto:${EMAIL}`}><code>{EMAIL}</code></a>
		</p>
	</div>
</BaseLayout>

<style>
	.socials {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 1.1rem;
		margin-top: -0.5em;
	}

	.socials a {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}
</style>
