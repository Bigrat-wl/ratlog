---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION } from '../../consts';
import { getReadingTime } from '../../utils/reading-time';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const groups: { year: number; posts: typeof posts }[] = [];
for (const post of posts) {
	// pubDate 由 schema 归一到 UTC 零点，年份也必须按 UTC 读，避免跨年错位
	const year = post.data.pubDate.getUTCFullYear();
	const last = groups.at(-1);
	if (last?.year === year) last.posts.push(post);
	else groups.push({ year, posts: [post] });
}

const langLabel = { zh: '中文', en: 'EN', ja: '日本語' } as const;
---

<BaseLayout title={`Blog`} description={SITE_DESCRIPTION}>
	<h1 class="sr-only">Blog</h1>
	<div class="prose list-head">
		<nav class="list-tabs" aria-label="Blog 与 About">
			<a class="active" href="/blog/" aria-current="page">Blog</a>
			<a href="/about/">About</a>
		</nav>
	</div>

	<div class="prose post-list">
		{groups.map((group) => (
			<>
				<div class="year" aria-hidden="true">
					<span>{group.year}</span>
				</div>
				{group.posts.map((post, index) => (
					<a
						class="post-item slide-enter"
						href={`/blog/${post.id}/`}
						style={`--enter-stage:${Math.min(index + 1, 10)}`}
					>
						<span class="title">
							{post.data.lang && <span class="lang">{langLabel[post.data.lang]}</span>}
							<span>{post.data.title}</span>
						</span>
						<span class="meta">
							<FormattedDate date={post.data.pubDate} format="month-day" />
							<span class="duration">· {getReadingTime(post.body)}min</span>
						</span>
					</a>
				))}
			</>
		))}
	</div>

	<div class="prose list-foot">
		<span class="prompt">&gt; </span>
		<a href="/rss.xml">RSS</a>
	</div>
</BaseLayout>

<style>
	.list-head {
		margin-bottom: 1.5rem;
	}

	.list-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		font-size: 1.875rem;
		font-weight: 500;
		line-height: 1.2;
	}

	.list-tabs a {
		color: var(--fg-deeper);
		opacity: 0.2;
		transition: opacity 0.2s ease;
	}

	.list-tabs a:hover {
		opacity: 0.5;
		text-decoration: none;
	}

	.list-tabs a.active {
		opacity: 1;
		text-decoration: underline;
		text-decoration-thickness: 1.5px;
		text-underline-offset: 5px;
	}

	.post-list {
		margin-top: 1rem;
	}

	.year {
		position: relative;
		height: 5rem;
		pointer-events: none;
		user-select: none;
	}

	.year span {
		position: absolute;
		top: -2rem;
		left: -3rem;
		color: transparent;
		font-size: 8em;
		font-weight: 800;
		line-height: 1;
		opacity: 0.1;
		-webkit-text-stroke: 2px var(--fg-light);
	}

	.post-item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0.5rem 0 1.5rem;
		opacity: 0.6;
		text-decoration: none;
		transition: opacity 0.2s ease;
	}

	.post-item:hover {
		opacity: 1;
	}

	.post-item .title {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--fg);
		font-size: 1.125rem;
		font-weight: 400;
		line-height: 1.2;
	}

	.post-item .meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-left: auto;
		font-size: 0.875rem;
		white-space: nowrap;
	}

	.post-item .meta time {
		opacity: 0.5;
	}

	.post-item .duration {
		opacity: 0.4;
	}

	.lang {
		flex: none;
		margin-left: -0.25rem;
		padding: 0.125rem 0.25rem;
		border-radius: 0.25rem;
		background-color: rgba(113, 113, 122, 0.15);
		color: #71717a;
		font-size: 0.75rem;
		font-weight: 500;
		line-height: 1.4;
	}

	html.dark .lang {
		background-color: rgba(161, 161, 170, 0.15);
		color: #a1a1aa;
	}

	.list-foot {
		margin-top: 2rem;
		font-family: var(--font-mono);
		font-size: 0.9rem;
		opacity: 0.6;
	}

	.list-foot .prompt {
		opacity: 0.7;
	}

	.list-foot a:hover {
		opacity: 0.75;
		text-decoration: none;
	}

	@media (max-width: 768px) {
		.post-item {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.125rem;
		}

		.post-item .meta {
			margin-left: 0;
		}

		.year span {
			left: -1rem;
		}
	}
</style>
