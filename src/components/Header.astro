---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SOCIALS } from '../consts';

// 去掉尾斜杠再比较，否则 `/blog` 永远匹配不上 `/blog/`
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const github = SOCIALS.find((social) => social.name === 'GitHub');

const isActive = (href: string) => {
	const target = href.replace(/\/+$/, '') || '/';
	return target === '/' ? path === '/' : path === target || path.startsWith(`${target}/`);
};

const links = [
	{ href: '/blog/', label: 'Blog', icon: 'article' as const },
	{ href: '/about/', label: 'About', icon: 'user' as const },
	{ href: '/projects/', label: 'Projects', icon: 'projects' as const },
	{ href: '/friends/', label: 'Friends', icon: 'link' as const },
];
---

<header class="site-header">
	<a class="site-logo" href="/" aria-label="回到首页">
		<Logo size={48} />
	</a>

	<nav class="site-nav" aria-label="主导航">
		{links.map((link) => {
			const active = isActive(link.href);
			return (
				<a
					href={link.href}
					class:list={['nav-link', { active }]}
					title={link.label}
					aria-current={active ? 'page' : undefined}
				>
					<span class="nav-label">{link.label}</span>
					<Icon name={link.icon} size={20} class="nav-icon" />
				</a>
			);
		})}
		{github && (
			<a
				href={github.url}
				class="nav-link"
				title={github.name}
				aria-label={github.name}
				target="_blank"
				rel="noopener noreferrer"
			>
				<Icon name="github" size={20} />
			</a>
		)}
		<a href="/rss.xml" class="nav-link" title="RSS" aria-label="RSS">
			<Icon name="rss" size={20} />
		</a>
		<button
			id="theme-toggle"
			type="button"
			class="nav-link theme-toggle"
			aria-label="切换主题"
			title="切换主题"
		>
			<Icon name="sun" size={20} class="icon-sun" />
			<Icon name="moon" size={20} class="icon-moon" />
		</button>
	</nav>
</header>

<button
	id="scroll-top"
	class="scroll-top"
	type="button"
	aria-label="回到顶部"
	title="回到顶部"
	aria-hidden="true"
	tabindex="-1"
>
	<Icon name="arrow-up" size={20} />
</button>

<script is:inline>
	;(() => {
		const root = document.documentElement;
		const toggle = document.getElementById('theme-toggle');

		toggle?.addEventListener('click', () => {
			const dark = root.classList.toggle('dark');
			try {
				localStorage.setItem('theme', dark ? 'dark' : 'light');
			} catch {}
			toggle.setAttribute('aria-label', dark ? '切换到浅色模式' : '切换到深色模式');
		});

		const media = window.matchMedia('(prefers-color-scheme: dark)');
		media.addEventListener?.('change', (event) => {
			let stored = null;
			try {
				stored = localStorage.getItem('theme');
			} catch {}
			if (!stored) root.classList.toggle('dark', event.matches);
		});

		const scrollTop = document.getElementById('scroll-top');
		const onScroll = () => {
			const visible = window.scrollY > 480;
			scrollTop?.classList.toggle('visible', visible);
			// 不显示时移出可达性树和 Tab 顺序，避免焦点落到隐形按钮上
			if (scrollTop) {
				scrollTop.setAttribute('aria-hidden', visible ? 'false' : 'true');
				scrollTop.setAttribute('tabindex', visible ? '0' : '-1');
			}
		};
		window.addEventListener('scroll', onScroll, { passive: true });
		onScroll();

		scrollTop?.addEventListener('click', () => {
			window.scrollTo({ top: 0, behavior: 'smooth' });
		});
	})();
</script>

<style>
	.site-header {
		position: relative;
		z-index: 40;
		padding: 2rem;
	}

	.site-logo {
		position: absolute;
		top: 1.25rem;
		left: 1.25rem;
		display: block;
		width: 3rem;
		height: 3rem;
		color: var(--fg-deeper);
	}

	.site-logo :global(svg) {
		width: 100%;
		height: 100%;
	}

	.site-nav {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 1.2rem;
		min-height: 1.25rem;
	}

	.nav-link {
		display: inline-flex;
		align-items: center;
		color: inherit;
		font-size: 0.9375rem;
		opacity: 0.6;
		transition:
			opacity 0.2s ease,
			color 0.2s ease;
	}

	.nav-link:hover,
	.nav-link.active {
		opacity: 1;
	}

	.site-nav :global(.nav-icon) {
		display: none;
	}

	.theme-toggle {
		position: relative;
		width: 1.25rem;
		height: 1.25rem;
	}

	.theme-toggle :global(.icon-sun),
	.theme-toggle :global(.icon-moon) {
		position: absolute;
		inset: 0;
		transition:
			opacity 0.2s ease,
			transform 0.3s ease;
	}

	.theme-toggle :global(.icon-moon) {
		opacity: 0;
		transform: rotate(-30deg) scale(0.8);
	}

	html.dark .theme-toggle :global(.icon-sun) {
		opacity: 0;
		transform: rotate(30deg) scale(0.8);
	}

	html.dark .theme-toggle :global(.icon-moon) {
		opacity: 1;
		transform: none;
	}

	.scroll-top {
		position: fixed;
		right: 0.75rem;
		bottom: 0.75rem;
		z-index: 100;
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		opacity: 0;
		pointer-events: none;
		transition:
			opacity 0.3s ease,
			background-color 0.2s ease;
	}

	.scroll-top.visible {
		opacity: 1;
		pointer-events: auto;
	}

	.scroll-top:hover {
		background-color: rgba(136, 136, 136, 0.19);
	}

	@media (min-width: 1280px) {
		.site-logo {
			position: fixed;
		}
	}

	@media (max-width: 640px) {
		.site-header {
			padding: 1.25rem;
		}

		.site-logo {
			top: 1rem;
			left: 1rem;
			width: 2.25rem;
			height: 2.25rem;
		}

		.site-nav {
			gap: 1rem;
		}

		.nav-label {
			display: none;
		}

		.site-nav :global(.nav-icon) {
			display: block;
		}
	}

	@media (max-width: 400px) {
		.site-nav {
			gap: 0.7rem;
		}
	}
</style>
