---
interface Props {
	date: Date;
	/** "long": Oct 1, 2022 / "month-day": Oct 1 */
	format?: 'long' | 'month-day';
}

const { date, format = 'long' } = Astro.props;

// 日期已由 content schema 归一到 UTC 零点，格式化时也必须按 UTC 读，
// 否则东八区会把 6 日 16:00Z 显示成 7 日。
const options: Intl.DateTimeFormatOptions = {
	timeZone: 'UTC',
	...(format === 'month-day'
		? { month: 'short', day: 'numeric' }
		: { year: 'numeric', month: 'short', day: 'numeric' }),
};

const value = date.toISOString().slice(0, 10);
---

<time datetime={value}>{date.toLocaleDateString('en-US', options)}</time>
