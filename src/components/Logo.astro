---
interface Props {
	size?: number;
}

const { size = 48 } = Astro.props;
---

<svg
	class="logo-mark"
	width={size}
	height={size}
	viewBox="0 0 64 64"
	fill="none"
	stroke="currentColor"
	stroke-width="4.2"
	stroke-linecap="round"
	stroke-linejoin="round"
	role="img"
	aria-label="Rat"
>
	<path d="M17 9v46" />
	<path d="M17 9h15c9.5 0 15 5.5 15 12.5S41.5 34 32 34H17" />
	<path d="M30 34l13 16c2.2 2.7 6 1.5 6.3-1.8" />
</svg>

<style>
	.logo-mark {
		display: block;
		overflow: visible;
		transition:
			transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
			opacity 0.2s;
		transform-origin: 50% 60%;
	}

	:global(a:hover) .logo-mark,
	:global(button:hover) .logo-mark {
		transform: rotate(-5deg) scale(1.05);
	}

	@media (prefers-reduced-motion: reduce) {
		.logo-mark {
			transition: none;
		}
	}
</style>
