---
interface Props {
	name:
		| 'github'
		| 'rss'
		| 'sun'
		| 'moon'
		| 'arrow-up'
		| 'article'
		| 'user'
		| 'link'
		| 'mail';
	size?: number;
	class?: string;
}

const { name, size = 20, class: className = '' } = Astro.props;
---

<svg
	class={className || undefined}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.8"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	{name === 'github' && (
		<path
			fill="currentColor"
			stroke="none"
			d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.19-.02-2.16-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14 0 1.55-.01 2.8-.01 3.18 0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"
		/>
	)}
	{name === 'rss' && (
		<>
			<path d="M4 11a9 9 0 0 1 9 9" />
			<path d="M4 4a16 16 0 0 1 16 16" />
			<circle cx="5" cy="19" r="1.4" fill="currentColor" stroke="none" />
		</>
	)}
	{name === 'sun' && (
		<>
			<circle cx="12" cy="12" r="4" />
			<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
		</>
	)}
	{name === 'moon' && <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />}
	{name === 'arrow-up' && (
		<>
			<path d="M12 19V5" />
			<path d="m5 12 7-7 7 7" />
		</>
	)}
	{name === 'article' && (
		<>
			<path d="M5 4h11l3 3v13H5z" />
			<path d="M8 9h8M8 13h8M8 17h5" />
		</>
	)}
	{name === 'user' && (
		<>
			<circle cx="12" cy="8" r="3.5" />
			<path d="M5 20a7 7 0 0 1 14 0" />
		</>
	)}
	{name === 'link' && (
		<>
			<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
			<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
		</>
	)}
	{name === 'mail' && (
		<>
			<rect x="3" y="5" width="18" height="14" rx="2" />
			<path d="m3.5 7 8.5 6 8.5-6" />
		</>
	)}
</svg>
