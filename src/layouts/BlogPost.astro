---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	lang?: 'zh' | 'en' | 'ja';
	minutes?: number;
}

const { title, description, pubDate, updatedDate, lang, minutes } = Astro.props;

const htmlLang = lang === 'zh' ? 'zh-CN' : lang === 'ja' ? 'ja' : 'en';
const langLabel = { zh: '中文', en: 'EN', ja: '日本語' } as const;
---

<BaseLayout title={title} description={description} lang={htmlLang}>
	<header class="prose post-head">
		{lang && (
			<span class="lang slide-enter" style="--enter-stage:0">{langLabel[lang]}</span>
		)}
		<h1 class="slide-enter" style="--enter-stage:0">{title}</h1>
		<p class="post-meta slide-enter" style="--enter-stage:1">
			<FormattedDate date={pubDate} />
			{minutes && <span>· {minutes}min</span>}
			{updatedDate && (
				<span class="updated">
					· 更新于 <FormattedDate date={updatedDate} />
				</span>
			)}
		</p>
	</header>

	<article class="prose post-content slide-enter-content">
		<slot />
	</article>

	<div class="prose post-foot">
		<hr />
		<a href="/blog">← 返回博客</a>
	</div>
</BaseLayout>

<style>
	.post-head {
		margin-bottom: 2rem;
	}

	.post-head h1 {
		margin: 0;
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.5rem;
		margin-top: 0.35em;
		margin-bottom: 0;
		font-size: 0.9375rem;
		opacity: 0.5;
	}

	.updated {
		opacity: 0.8;
	}

	.lang {
		display: inline-block;
		margin-bottom: 0.5rem;
		padding: 0.1rem 0.3rem;
		border-radius: 0.25rem;
		background-color: rgba(113, 113, 122, 0.15);
		color: #71717a;
		font-size: 0.75rem;
		font-weight: 500;
		line-height: 1.4;
	}

	html.dark .lang {
		background-color: rgba(161, 161, 170, 0.15);
		color: #a1a1aa;
	}

	.post-foot {
		margin-top: 3rem;
		font-size: 0.9375rem;
	}

	.post-foot hr {
		margin: 2em 0;
	}
</style>
